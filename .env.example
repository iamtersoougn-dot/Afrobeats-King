# Names only. Set real values in Vercel → Project → Settings → Environment Variables, then redeploy.

# Site
NEXT_PUBLIC_SITE_URL=                 # e.g. https://afrobeats-king.vercel.app (used for payment return links)
NEXT_PUBLIC_OPERATOR_NAME=            # who runs the game, shown on Privacy and Terms
NEXT_PUBLIC_CONTACT_EMAIL=            # contact on Privacy and Terms (a business address, not a personal one)

# Supabase (live map, genre camps, invites, leaderboard, reports, analytics, purchase records)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=            # server only, never NEXT_PUBLIC
LIVE_INTERVAL_SEC=                    # optional: seconds between live heartbeats (default 45)
LIVE_OFF=                             # optional: 1 switches the live map off

# Payments: Flutterwave first, Paystack as backup
NEXT_PUBLIC_PAYMENTS_PROVIDER=        # flutterwave (leave empty to use Paystack if its key is set)
FLW_SECRET_KEY=                       # Flutterwave → Settings → API keys (server only)
FLW_SECRET_HASH=                      # any long random text; paste the same into Flutterwave → Webhooks → Secret hash
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# NEXT_PUBLIC_DEMO_PURCHASES=true     # preview deployments only: free test purchases

# Ads and sponsors
NEXT_PUBLIC_ADSENSE_CLIENT=           # ca-pub-… for Google H5 game ads (rewarded)
NEXT_PUBLIC_SPONSORS_JSON=            # {"billboards":[{"id":"b12","slot":"bridge","brand":"…","line":"…","color":"#ffc93c","url":"https://…"}],"songs":[{"id":"b13","artist":"…","title":"…","url":"https://…"}]}
AD_REPORT_SECRET=                     # any long random text; signs the private report links for advertisers
NEXT_PUBLIC_ANALYTICS=                # set to off to stop first-party analytics
